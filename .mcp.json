{
  "$comment": "generated by ai-hub; edit via ~/.ai-hub/workspaces/defaults.json",
  "mcpServers": {
    "code-review-graph": {
      "command": "${HOME}/.ai-hub/.venv/bin/ai-hub",
      "args": [
        "mcp-project-bridge",
        "--kind",
        "code-review-graph"
      ],
      "env": {
        "CRG_RECURSE_SUBMODULES": "1"
      },
      "type": "stdio"
    }
  }
}
